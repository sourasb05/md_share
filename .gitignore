# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Data: notes, sessions and the password fingerprint live here ---
data/
*.sqlite
*.sqlite-*
*.db
backup*.sqlite

