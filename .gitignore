node_modules/
public/editor.js
public/home.js
public/chunks/
public/katex/
public/fonts/

# --- Test output, logs, local tooling ---
/*.png
test-results/
*.log
npm-debug.log*
.DS_Store
.claude/settings.local.json
.vscode/
.idea/
